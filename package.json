{
  "name": "muse-cookie-session",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Local-only launcher for restoring your own muse.ai browser session from exported cookies.",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "tauri": "tauri",
    "session:start": "node src/index.js",
    "check": "node --check src/index.js && node --check ui/main.js",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5",
    "vite": "^7.1.12"
  }
}
